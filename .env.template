# Environment variables template
# Copy this file to .env and fill in your credentials

# Sentinel Hub API credentials (REQUIRED)
SENTINEL_CLIENT_ID=your_client_id_here
SENTINEL_CLIENT_SECRET=your_client_secret_here

# Optional API configuration
SENTINEL_TIMEOUT=300
SENTINEL_MAX_RETRIES=3
SENTINEL_RETRY_DELAY=5

# Optional processing configuration
SENTINEL_RESOLUTION=10
SENTINEL_MAX_CLOUD=0.3
SENTINEL_OUTPUT_FORMAT=GTiff
SENTINEL_COMPRESSION=lzw
SENTINEL_DATA_TYPE=float32